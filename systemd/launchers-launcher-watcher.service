# Launchers Launcher — socket-watcher user unit.
#
# NOTE: this file does NOT run from the repo automatically. On the machine the
# ~/.config/systemd/user/launchers-launcher-watcher.service copy runs (synced by hand),
# and ExecStart calls the /usr/local/bin/ copy — see
# systemd/README.md + docs/dev/install-update.md#bin-scripts-and-where-they-run-from.
#
# This template follows the version proven to work on the machine (no PartOf=,
# WantedBy=default.target). default.target is the user session's default target;
# After=graphical-session.target is enough for the Wayland timing.

[Unit]
Description=Launchers Launcher Trigger Watcher
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/launchers-launcher-watcher.sh
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
